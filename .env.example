# Hướng dẫn từng bước: mở docs/setup-guide.html trong trình duyệt.

# === Discord application ===
# Developer Portal > Applications > app của bạn
# Bot > Reset Token để lấy token, và BẮT BUỘC bật Server Members Intent
# (không bật thì bot không nhận được sự kiện join, mất toàn bộ số liệu nguồn).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# === Server nhà ===
# Server bạn muốn kéo người vào. Bot cần quyền Manage Server ở đây để đọc invite,
# và Manage Roles nếu muốn bot gán role cho người đăng ký nhận thông báo.
HOME_GUILD_ID=

# === Dashboard ===
# Discord user ID được phép đăng nhập dashboard, nhiều ID cách nhau bằng dấu phẩy
DASHBOARD_OWNER_IDS=
# Chuỗi random dài để ký session cookie. Tạo bằng: openssl rand -hex 32
# Đổi giá trị này là mọi phiên đang đăng nhập bị vô hiệu.
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
# Mặc định chỉ mở ở máy local. Chỉ đổi thành 0.0.0.0 khi đã có HTTPS + reverse proxy.
HOST=127.0.0.1
# Địa chỉ bạn mở dashboard. Developer Portal > OAuth2 > Redirects phải có đúng
# chuỗi này + /api/auth/callback, giống từng ký tự, không thừa dấu / ở cuối.
PUBLIC_BASE_URL=http://localhost:3000

# === Tuỳ chọn ===
# Nhịp gửi DM (ms giữa 2 tin). Giữ mức thoải mái, đừng hạ quá thấp.
DM_INTERVAL_MS=2500
DATABASE_FILE=data/growth.db
