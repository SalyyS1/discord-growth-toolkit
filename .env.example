# === Discord application ===
# Developer Portal > Applications > your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# === Home server (Discord SukiMC) ===
# Server bạn muốn kéo người vào. Bot cần quyền Manage Guild ở đây để đọc invite.
HOME_GUILD_ID=

# === Dashboard ===
# Discord user ID được phép đăng nhập dashboard, nhiều ID cách nhau bằng dấu phẩy
DASHBOARD_OWNER_IDS=
# Chuỗi random dài để ký session cookie (đổi thành giá trị của bạn)
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
# Mặc định chỉ mở ở máy local. Chỉ đổi thành 0.0.0.0 khi đã có HTTPS + reverse proxy.
HOST=127.0.0.1
# Phải trùng redirect URI khai trong Developer Portal > OAuth2
PUBLIC_BASE_URL=http://localhost:3000

# === Tuỳ chọn ===
# Nhịp gửi DM opt-in (ms giữa 2 DM). Giữ mức thoải mái, đừng hạ quá thấp.
DM_INTERVAL_MS=2500
DATABASE_FILE=data/growth.db
